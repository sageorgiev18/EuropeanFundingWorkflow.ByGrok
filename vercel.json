{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "scrapers": {
      "root": "scrapers",
      "runtime": "python",
      "entrypoint": "run_all.py"
    },
    "sofia_municipality": {
      "root": "scrapers/sources/sofia_municipality",
      "runtime": "python",
      "entrypoint": "scraper.py"
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "scrapers",
          "format": "url",
          "env": "SCRAPERS_URL"
        },
        {
          "type": "service",
          "service": "sofia_municipality",
          "format": "url",
          "env": "SOFIA_MUNICIPALITY_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
